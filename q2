const Child = React.memo(({ user }) => {
  console.log("Child");
  return <div>{user.name}</div>;
});
 
function App() {
  const [count, setCount] = useState(0);
 
  const user = {
  name: "John"
  };
 
  return (
<>
<Child user={user} />
 
  <button onClick={() => setCount(count + 1)}>
  {count}
</button>
</>
  );
}
